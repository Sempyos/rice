(imageButtonWH :class "btn" :cmd "gtk-launch org.gnome.Calendar.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/org.gnome.Calendar.svg" :txt "Calendar")
(imageButtonWH :class "btn" :cmd "gtk-launch org.gnome.Epiphany.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/org.gnome.Epiphany.svg" :txt "Web")
(imageButtonWH :class "btn" :cmd "gtk-launch org.gnome.Fractal.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/org.gnome.Fractal.svg" :txt "Fractal")
(imageButtonWH :class "btn" :cmd "gtk-launch org.gnome.gitlab.YaLTeR.Identity.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/org.gnome.gitlab.YaLTeR.Identity.svg" :txt "Identity")
(imageButtonWH :class "btn" :cmd "gtk-launch org.gnome.gitlab.YaLTeR.VideoTrimmer.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/org.gnome.gitlab.YaLTeR.VideoTrimmer.svg" :txt "Video Trimmer")
