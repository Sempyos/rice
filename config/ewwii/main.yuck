(defwidget st []
  (box :class "statusChip" :space-evenly true :orientation "v"
  (box :class "statusChip" :space-evenly false :orientation "h"
  (label :text "${time}" :valign "center")
  (eventbox :space-evenly false :onhover "~/ewwii/target/release/ewwii wc property-update --widget 'reva' reveal-child=true" :onhoverlost "~/ewwii/target/release/ewwii wc property-update --widget 'reva' reveal-child=false" :onclick "~/.config/ewwii/toggle.fish"
  (overlay
  (progress :active true :class "batteryBar" :value bat :orientation "h" :flipped true)
  (revealer :transition "crossfade" :widget-name "reva"
  (label :text "${bat}%" :style {bat > 50 ? "color: #680014;" : "color: #F8DCDB;"}))
  )))
  (revealer :transition "slidedown" :reveal true
  (label :text "manu"))
  ))

(defvar r true)

(defwidget as []
(revealer :transition "slideright" :reveal r :widget-name "rev"
(box :style "background-image: linear-gradient(
    to right,
    #091614,
    #09161499,
    #09161400
);"
(scroll :hscroll false :propagate_natural_height true 
(box :orientation "v" :space-evenly true
(imageButtonWH :class "btn" :cmd "gtk-launch chromium.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/256x256/apps/chromium.png" :txt "Chromium")
(imageButtonWH :class "btn" :cmd "gtk-launch com.pocoguy.Muse.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/com.pocoguy.Muse.svg" :txt "Muse")
(imageButtonWH :class "btn" :cmd "gtk-launch de.haeckerfelix.Fragments.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/de.haeckerfelix.Fragments.svg" :txt "Fragments" )
(imageButtonWH :class "btn" :cmd "gtk-launch dev.faetalize.waytator.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/512x512/apps/dev.faetalize.waytator.png" :txt "Waytator")
(imageButtonWH :class "btn" :cmd "gtk-launch foot-server.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/foot.svg" :txt "Foot")
(imageButtonWH :class "btn" :cmd "gtk-launch foot.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/foot.svg" :txt "Foot")
(imageButtonWH :class "btn" :cmd "gtk-launch footclient.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/foot.svg" :txt "Foot")
(imageButtonWH :class "btn" :cmd "gtk-launch helix.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/256x256/apps/helix.png" :txt "Helix")
(imageButtonWH :class "btn" :cmd "gtk-launch io.github.nozwock.Packet.desktop" :width 32 :height 32 :path "/usr/share/icons/hicolor/scalable/apps/io.github.nozwock.Packet.svg" :txt "Packet")
