; ;Widget Constructors
; ;Prefer
; (defwidget imageButton [ cmd class path fill ]
;   (button :onclick cmd
;     (image :class class :path path :fill-svg fill)))

(defwidget imageButtonWHL [ ?buttonClass cmd class width height path fill ]
  (eventbox :class "eb" :onclick cmd :width 256 :height 256
    (image :class class :content-fit "scaledown" :can-shrink false :image-width width :image-height height :path path :fill-svg fill)))


(defwidget imageButtonWH [ ?buttonClass cmd class width height path ?fill ?txt ]
  (eventbox :onclick cmd :orientation "h" :space-evenly false :style "margin-top: 16px; margin-bottom: 16px; margin-left: 16px; "
  (box :space-evenly false
    (image :class class :content-fit "scaledown" :can-shrink false :image-width width :image-height height :path path )
    (label :text "${txt}" :valign "center"))))

