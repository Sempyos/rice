(defwidget logout []
  (box :space-evenly false :orientation "v"
    (box :space-evenly false :orientation "h"
      (imageButtonWHL :cmd "systemctl sleep && eww close darken logout" :class "logoutTopLeft logoutPadding" :width "128" :height "128" :path "icons/sleep.svg" :fill "#ff7aac")
      (imageButtonWHL :cmd "systemctl hibernate && eww close darken logout" :class "logoutTopRight logoutPadding" :width "128" :height "128" :path "icons/hibernate.svg" :fill "#ff7aac"))
    (box :space-evenly false :orientation "h"
      (imageButtonWHL :cmd "systemctl poweroff && eww close darken logout" :class "logoutBottomLeft logoutPadding" :width "128" :height "128" :path "icons/shutdown.svg" :fill "#ff7aac")
      (imageButtonWHL :cmd "systemctl reboot && eww close darken logout" :class "logoutBottomRight logoutPadding" :width "128" :height "128" :path "icons/reboot.svg" :fill "#ff7aac"))))


