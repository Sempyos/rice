(defwindow statusChip
  :monitor 0
  :geometry (geometry :x "16" :y "16" :width "24" :height "32" :anchor "top right")
  :stacking "fg"
  :force-normal true
  (st))

(defwindow appScroll
  :monitor 0
  :geometry (geometry :height "100%" :anchor "center left")
  :stacking "fg"
  (as))
